# Normalize to LF on commit, convert to OS line endings on checkout.
# Auto-detection handles all source files; only binaries need marking, since a
# misdetected binary would get CRLF-mangled on Windows checkout.
* text=auto

# Binary — never touch line endings, no textual diff or merge
*.png    binary
*.jpg    binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.gz     binary
*.tar.gz binary
*.exe    binary
*.dll    binary
*.so     binary
*.a      binary
*.lib    binary
*.o      binary
*.obj    binary
